# --- AI (free — no credit card needed) ---
GROQ_API_KEY=
# Optional override. "llama-3.3-70b-versatile" (default) or "deepseek-r1-distill-llama-70b"
GROQ_MODEL=llama-3.3-70b-versatile

# --- Database / Auth (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- SEO Data: Google Search Console (Phase 2, first integration) ---
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered in Google Cloud Console
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
SERPAPI_API_KEY=

# --- Publishing (optional — WordPress needs no app review, unlike Meta/LinkedIn) ---
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# --- Used to redirect back to the frontend after OAuth callbacks ---
FRONTEND_URL=http://localhost:3000
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Social Platforms (Phase 2 remainder — needs App Review before going live) ---
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:8000/auth/meta/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback
X_API_KEY=
X_API_SECRET=

# --- Image / Video Gen (optional, later) ---
DALLE_API_KEY=
RUNWAYML_API_KEY=
HEYGEN_API_KEY=

# --- Module 2 weekly auto-generator (free version, no Redis/Celery needed) ---
# A random string you make up — put the same value into your free cron
# service (e.g. cron-job.org) as a header so only it can trigger the scan.
INTERNAL_SCAN_SECRET=
